@@ -0,0 +1,38 @@
+package tls
+
+import (
+	"context"
+
+	utls "github.com/refraction-networking/utls"
+	"github.com/xtls/xray-core/common/errors"
+	"github.com/xtls/xray-core/common/net"
+)
+
+// HelloChromeChaCha ("chrome-chacha") is Chrome's ClientHello with every AES cipher suite
+// removed. Servers that enforce their own AES-first order must then pick ChaCha20-Poly1305,
+// which is ~3.5x faster on CPUs without AES instructions (e.g. ARMv7 routers), while TLS 1.3
+// and the rest of the Chrome fingerprint stay intact.
+var HelloChromeChaCha = utls.ClientHelloID{Client: "ChromeChaCha", Version: "1"}
+
+func chromeChaChaUClient(c net.Conn, config *utls.Config) *utls.UConn {
+	spec, err := utls.UTLSIdToSpec(utls.HelloChrome_Auto)
+	if err == nil {
+		suites := make([]uint16, 0, len(spec.CipherSuites))
+		for _, s := range spec.CipherSuites {
+			switch s {
+			case utls.GREASE_PLACEHOLDER,
+				utls.TLS_CHACHA20_POLY1305_SHA256,
+				utls.TLS_ECDHE_ECDSA_WITH_CHACHA20_POLY1305_SHA256,
+				utls.TLS_ECDHE_RSA_WITH_CHACHA20_POLY1305_SHA256:
+				suites = append(suites, s)
+			}
+		}
+		spec.CipherSuites = suites
+		uConn := utls.UClient(c, config, utls.HelloCustom)
+		if err = uConn.ApplyPreset(&spec); err == nil {
+			return uConn
+		}
+	}
+	errors.LogWarning(context.Background(), "chrome-chacha fingerprint unavailable, falling back to chrome: ", err)
+	return utls.UClient(c, config, utls.HelloChrome_Auto)
+}
